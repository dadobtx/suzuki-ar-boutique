# Target de deploy: 'ghpages' | 'vercel' | '' (local)
VITE_TARGET=

# Inyectados en build
VITE_KIOSK_FLAG=off

# Feature Flags
VITE_LIVE_TRYON=on
VITE_BUILD_DATE=

# URL del backend AI proxy (Cloudflare Worker)
# Local dev: http://localhost:8787
# Producción: https://suzuki-ar-ai-proxy.<your-account>.workers.dev
VITE_AI_BACKEND_URL=