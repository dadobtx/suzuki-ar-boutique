# Target de deploy: 'ghpages' | 'vercel' | '' (local)
VITE_TARGET=

# Inyectados en build
VITE_KIOSK_FLAG=off

# Feature Flags
VITE_LIVE_TRYON=on
VITE_BUILD_DATE=

# URL del backend AI proxy (Cloudflare Worker)
# Local dev: http://localhost:8787
# Producción: https://suzuki-ar-ai-proxy.<your-account>.workers.dev
VITE_AI_BACKEND_URL=

# Base URL para assets públicos consumidos por servicios externos (Live Try-on con fal / Lucy 2)
# En dev sigue apuntando a producción a propósito porque fal requiere URLs públicas accesibles por internet
VITE_PUBLIC_ASSETS_BASE=https://dadobtx.github.io/suzuki-ar-boutique/